@startuml
'https://plantuml.com/class-diagram
/'Aggregation'/

class Instructor{
    - firstName : String
    - lastName : String
    - officeNumber : String

    + Instructor( firstName : String, lastName : String,
    officeNumber : String)

    + getFirstName() : String
    + setFirstName( firstName : String ) : void

    + getLastName() : String
    + setLastName( lastName : String ) : void

    + getOfficeNumber() : String
    + setOfficeNumber( officeNumber : String ) : void

}/'end of Instructor'/

class TextBook{
    - bookTitle : String
    - author : String
    - bookPublisher : String

    + TextBook( bookTitle : String, author : String,
    bookPublisher : String )

    + getBookTitle() : String
    + setBookTitle( bookTitle : String ) : void

    + getAuthor() : String
    + setAuthor( author : String ) : void

    + getBookPublisher() : String
    + setBookPublisher( bookPublisher : String ) : void


}/'end of Textbook'/

class Course{
    - course : String
    - instructor : Instructor
    - instructor2 : Instructor
    - textBook : TextBook
    - textBook2 : TextBook

    + Course( course : String, instructor : Instructor, textBook : TextBook,
    instructor2 : Instructor, textBook2 : TextBook)

    + print() : void


}/'end of Course'/

Course o-- Instructor
Course o-- TextBook

@enduml