@startuml
'https://plantuml.com/class-diagram
/'Composition'/

class Folder{
    - name : String
    - files : ArrayList<File>
    - subfolders : ArrayList<Folder>

    + Folder( name : String )

    + getName() : String
    + setName( name : String ) : void

    + addFile( f : File ) : void

    + addFolder( f : Folder ) : void

    + deleteFolder( folderName : String ) : void

    + print() : void

}/'end of Folder'/

class File{
    - name : String

    + File( name : String )

    + getName() : String
    + setName( name: String ) : void

    + print() : void


}/'end of File'/

Folder *-- "0..*" File
Folder *-- "0..*" Folder



@enduml